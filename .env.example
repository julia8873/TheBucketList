# ─── Supabase (local dev) ────────────────────────────────────────────────────
# These are the default values from `supabase start`.
# Do NOT change for local development.
EXPO_PUBLIC_SUPABASE_URL_LOCAL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL_EMULATOR=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY_LOCAL=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7kyqd3V4AGSJlZ5V2P8VWv7Tc3KzGgLn9KI

# ─── Supabase (staging) ──────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL_STAGING=https://your-staging-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY_STAGING=your-staging-anon-key

# ─── Supabase (production) ───────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL_PROD=https://your-prod-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY_PROD=your-prod-anon-key

# ─── Active environment (local | staging | prod) ─────────────────────────────
APP_ENV=local

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Android OAuth client ID from Firebase console (same project as FCM)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com

# ─── FCM (Firebase Cloud Messaging) ─────────────────────────────────────────
# Service account JSON as a single-line string (for Edge Function `send-push`)
# IMPORTANT: store this as a Supabase secret, not here.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ─── Web Push (VAPID) ────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ─── Sentry (optional, opt-in) ───────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=

# ─── Brevo SMTP (configured inside Supabase dashboard, not app) ──────────────
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@email.com
# SMTP_PASS=your-brevo-smtp-key

# ─── Cloudflare Pages (CI/CD) ────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your-cf-account-id
CLOUDFLARE_API_TOKEN=your-cf-api-token

# ─── GitHub Actions anti-pause ────────────────────────────────────────────────
# These must be set as GitHub repository secrets (Settings → Secrets)
# SUPABASE_URL_STAGING  (same as EXPO_PUBLIC_SUPABASE_URL_STAGING)
# SUPABASE_URL_PROD     (same as EXPO_PUBLIC_SUPABASE_URL_PROD)
# SUPABASE_ANON_KEY_STAGING
# SUPABASE_ANON_KEY_PROD
# BACKUP_ENCRYPTION_PASSPHRASE

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
out/
web-build/
.expo/
.expo-shared/
*.tsbuildinfo

# ── Native builds (generated by Expo prebuild — never commit) ────────────────
android/
ios/

# ── Certificates & signing ───────────────────────────────────────────────────
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.cer
*.certSigningRequest
*.provisionprofile

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem

# ── Firebase ─────────────────────────────────────────────────────────────────
google-services.json
GoogleService-Info.plist
firebase-service-account.json

# ── Supabase local state ─────────────────────────────────────────────────────
supabase/.branches
supabase/.temp
supabase/.env

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Testing & coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/

# ── Turbo ────────────────────────────────────────────────────────────────────
.turbo/

# ── Metro bundler cache ──────────────────────────────────────────────────────
.metro-health-check*
metro-cache/

# ── EAS / Expo Application Services ─────────────────────────────────────────
.easignore
eas-cli-log*

# ── Temporary & backup files ─────────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.dump
*.gpg
